# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production (e.g. Netlify / Vercel / Render static site),
# set VITE_API_URL as an environment variable in your hosting dashboard.

# Local development (FastAPI running on your machine)
VITE_API_URL=http://127.0.0.1:8000

# Production example (uncomment and set your Render backend URL)
# VITE_API_URL=https://your-backend.onrender.com
