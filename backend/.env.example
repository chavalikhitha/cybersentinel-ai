# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production (Render), set these as environment variables
# in the Render dashboard — do NOT commit a real .env file.

# Comma-separated list of allowed frontend origins
# Local:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (uncomment and set your real frontend URL):
# ALLOWED_ORIGINS=https://cybersentinel-ai.onrender.com
